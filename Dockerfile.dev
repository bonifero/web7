FROM ruby:3.4.11-slim
WORKDIR /rails
RUN sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list.d/debian.sources && apt-get update -qq && apt-get install --no-install-recommends -y build-essential libyaml-dev git sqlite3 libvips curl && rm -rf /var/lib/apt/lists/*
COPY Gemfile Gemfile.lock ./
RUN bundle install
COPY . .
EXPOSE 3000
CMD ["bash", "-lc", "bundle exec rails db:prepare && bundle exec rails dartsass:build && bundle exec rails server -b 0.0.0.0"]

